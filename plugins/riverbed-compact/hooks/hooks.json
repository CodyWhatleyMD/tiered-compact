{
  "description": "Intercepts /riverbed-compact and creates a compacted destination session.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "^/(?:riverbed-compact:)?(?:riverbed-compact|whoami)(?:\\s+.*)?$|^<command-message>[^<]*</command-message>\\s*<command-name>/(?:riverbed-compact:)?(?:riverbed-compact|whoami)</command-name>",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["${CLAUDE_PLUGIN_ROOT}/src/hook.ts"],
            "timeout": 570,
            "statusMessage": "Running Riverbed Compact"
          }
        ]
      }
    ]
  }
}
